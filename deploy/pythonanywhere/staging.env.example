# HOA HOE / Step 11.4 - EXAMPLE ONLY. Never commit a real .env.
# Staging (private, NOT for real customer orders).
# Use this layout in backend/.env on the HOSTING ONLY after inserting real values.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DJANGO_ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR_USERNAME.pythonanywhere.com
DB_ENGINE=mysql
# From PythonAnywhere Databases tab. NAME often looks like USERNAME$hoa_hoe
DB_NAME=YOUR_USERNAME$hoa_hoe
DB_USER=YOUR_USERNAME
DB_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
DB_HOST=READ_FROM_PYTHONANYWHERE_DATABASES_TAB
DB_PORT=3306
# Explicit opt-in: allow ONLY whitelisted HTML when DEBUG=False.
HOA_MANAGED_FRONTEND_ENABLED=True
HOA_PUBLIC_ROOT=/home/YOUR_USERNAME/HoaHoe_deploy_public
# HTTPS / reverse proxy must be tested on your actual host to avoid redirect loops.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
DJANGO_TRUST_PROXY_SSL_HEADER=False
