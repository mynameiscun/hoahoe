# MAU DUNG CHO SYSTEMD EnvironmentFile (khong commit file production.env that).
# Khong copy y nguyen len server. Thay cac gia tri __...__ bang secret/domain THUC.
# Neu secret co dau cach, ky tu dac biet, phai quote theo systemd envfile.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=__RANDOM_SECRET_AT_LEAST_50_CHARACTERS__
DJANGO_ALLOWED_HOSTS=__DOMAIN__,www.__DOMAIN__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__DOMAIN__,https://www.__DOMAIN__
DB_ENGINE=mysql
DB_NAME=__PROD_DB_NAME__
DB_USER=__PROD_DB_USER__
DB_PASSWORD=__PROD_DB_PASSWORD__
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
# Chi True neu Nginx GHI DE header X-Forwarded-Proto nhan tu client.
DJANGO_TRUST_PROXY_SSL_HEADER=True
